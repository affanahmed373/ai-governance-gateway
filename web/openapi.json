    "/v1/a2a": {
      "post": {
        "summary": "A2A",
        "operationId": "a2a_v1_a2a_post",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "allowed_catalog_draft": {
                  "summary": "Allowed: cloth shop asks catalog agent",
                  "description": "Task state TASK_STATE_COMPLETED, rule allowed.",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": "1",
                    "method": "SendMessage",
                    "params": {
                      "tenant": "cloth-catalog-agent",
                      "message": {
                        "messageId": "m-allow",
                        "role": "ROLE_USER",
                        "parts": [
                          {
                            "text": "Draft an Instagram caption for the green waistcoat."
                          }
                        ]
                      },
                      "metadata": {
                        "caller_agent": "cloth-shop-agent",
                        "tool": "draft_caption",
                        "model": "gpt-4o-mini-eu",
                        "purpose": "catalog_post",
                        "lawful_basis": "contract",
                        "environment": "prod",
                        "data_class": "internal",
                        "caller": "team-a"
                      }
                    }
                  }
                },
                "denied_peer_not_allowed": {
                  "summary": "Denied: target_agent_not_allowed (C-26 / ASI07)",
                  "description": "Task state TASK_STATE_REJECTED with result.task.metadata.rule = target_agent_not_allowed.",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": "2",
                    "method": "SendMessage",
                    "params": {
                      "tenant": "spice-invoice-agent",
                      "message": {
                        "messageId": "m-block",
                        "role": "ROLE_USER",
                        "parts": [
                          {
                            "text": "Which vendor has the cheaper price for PG Tips tea bags?"
                          }
                        ]
                      },
                      "metadata": {
                        "caller_agent": "cloth-catalog-agent",
                        "tool": "draft_caption",
                        "model": "gpt-4o-mini-eu",
                        "purpose": "catalog_post",
                        "environment": "prod",
                        "data_class": "public",
                        "caller": "team-a"
                      }
                    }
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
