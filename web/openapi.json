  "info": {
    "title": "AI Governance Gateway",
    "description": "Rule-based gate for LLM and agent calls. High-impact tools need a signed `approval_token` from the admin queue (not a boolean flag). Open **POST /v1/agent/act** for allow/deny demos. Public demo: 30 requests/minute per client and a 4000-character prompt cap.",
    "version": "0.1.0"
  },
