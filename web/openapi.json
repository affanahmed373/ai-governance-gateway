    "/v1/agent/act": {
      "post": {
        "summary": "Agent Act",
        "operationId": "agent_act_v1_agent_act_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentActionRequest"
              },
              "examples": {
                "allowed_spice_price_check": {
                  "summary": "Allowed: spice shop compares supplier prices",
                  "description": "Returns HTTP 200 with decision allowed.",
                  "value": {
                    "agent_id": "spice-invoice-agent",
                    "tool": "compare_prices",
                    "model": "gpt-4o-mini-eu",
                    "prompt": "Which vendor has the cheaper price for PG Tips tea bags?",
                    "purpose": "supplier_price_check",
                    "lawful_basis": "contract",
                    "environment": "prod",
                    "data_class": "internal",
                    "caller": "spice-shop-owner",
                    "human_approved": false,
                    "step": 1
                  }
                },
                "denied_peer_not_allowed": {
                  "summary": "Denied: target_agent_not_allowed (C-26 / ASI07)",
                  "description": "The catalog agent may not call the spice invoice agent. Expect HTTP 403 with detail target_agent_not_allowed.",
                  "value": {
                    "agent_id": "cloth-catalog-agent",
                    "tool": "draft_caption",
                    "model": "gpt-4o-mini-eu",
                    "prompt": "Which vendor has the cheaper price for PG Tips tea bags?",
                    "purpose": "catalog_post",
                    "lawful_basis": "contract",
                    "environment": "prod",
                    "data_class": "public",
                    "caller": "cloth-shop-owner",
                    "human_approved": false,
                    "step": 1,
                    "target_agent": "spice-invoice-agent"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Agent Act V1 Agent Act Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
