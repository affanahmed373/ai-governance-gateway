# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Azure demo deploy (infra/azure/demo, see docs/azure-demo.md) ---
# Terraform's azurerm provider reads these ARM_* variables. Create a service principal with:
#   az ad sp create-for-rbac --name sp-aigw-demo --role Contributor --scopes /subscriptions/<subscription-id>
# and copy appId -> ARM_CLIENT_ID, password -> ARM_CLIENT_SECRET, tenant -> ARM_TENANT_ID.
# Leave the client id and secret empty to use your `az login` session instead.

ARM_SUBSCRIPTION_ID=
ARM_TENANT_ID=
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=

# Optional overrides for infra/azure/demo/variables.tf
TF_VAR_location=northeurope
TF_VAR_image=ghcr.io/affanahmed373/ai-governance-gateway:latest

# --- Admin console + signed approvals (see docs/admin-console.md, ADR 0010) ---
# Defaults work for local demo; change them on any shared deploy.
GATEWAY_APPROVAL_SECRET=dev-only-change-me
GATEWAY_ADMIN_TOKEN=dev-admin-token
GATEWAY_APPROVAL_TTL_SECONDS=900
# Comma-separated browser origins allowed to call the API (Vercel + local Next.js).
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Hugging Face (not the current host; Docker Spaces need PRO, see docs/hf-space.md) ---
# Create a token at https://huggingface.co/settings/tokens (write access for Spaces).

HF_TOKEN=
HF_USERNAME=affanahmed373
HF_SPACE_ID=ai-governance-gateway
